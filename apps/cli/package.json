{
  "name": "@projectify/cli",
  "version": "1.0.0",
  "description": "CLI for Projectify - Manage projects and tasks from the terminal",
  "type": "module",
  "private": false,
  "publishConfig": {
    "access": "restricted"
  },
  "bin": {
    "pjfy": "./bin/pjfy.js"
  },
  "files": [
    "dist",
    "bin",
    "README.md"
  ],
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "build:binaries": "node scripts/build-binaries.mjs",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "release:check": "pnpm lint && pnpm typecheck && pnpm build && pnpm build:binaries",
    "release:dry-run": "pnpm build && pnpm pack --pack-destination releases",
    "release:publish": "pnpm release:check && pnpm publish --access restricted --no-git-checks",
    "prepublishOnly": "pnpm release:check"
  },
  "keywords": [
    "cli",
    "projectify",
    "project-management",
    "task-management"
  ],
  "author": "Projectify",
  "license": "MIT",
  "dependencies": {
    "chalk": "^5.3.0",
    "cli-table3": "^0.6.5",
    "commander": "^12.1.0",
    "conf": "^13.0.1",
    "convex": "^1.33.0",
    "inquirer": "^12.3.3",
    "ora": "^9.3.0"
  },
  "devDependencies": {
    "@types/node": "^25.2.3",
    "@workspace/eslint-config": "workspace:^",
    "@workspace/typescript-config": "workspace:*",
    "eslint": "^9.39.2",
    "pkg": "^5.8.1",
    "tsup": "^8.4.2",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
